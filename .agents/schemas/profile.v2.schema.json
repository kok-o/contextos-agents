{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileV2",
  "description": "ContextOS Profile Schema v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "skills",
    "policy",
    "generation",
    "technologyDefaults"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique profile identifier slug"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable profile title"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Short explanation of the profile intent and constraints"
    },
    "skills": {
      "type": "object",
      "required": ["required", "preferred", "excluded"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Mandatory skill IDs enforced for tasks under this profile"
        },
        "preferred": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Priority skill IDs favored by this profile"
        },
        "excluded": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skill IDs strictly disabled or suppressed under this profile"
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["verification", "review", "security"],
      "additionalProperties": false,
      "properties": {
        "verification": {
          "type": "string",
          "enum": ["required", "recommended", "off"],
          "description": "Quality gate policy for automated test execution"
        },
        "review": {
          "type": "string",
          "enum": ["required", "recommended", "off"],
          "description": "Quality gate policy for code review before merge"
        },
        "security": {
          "type": "string",
          "enum": ["required", "recommended", "off"],
          "description": "Quality gate policy for security vulnerability checks"
        },
        "adr": {
          "type": "string",
          "enum": ["required", "recommended", "off"],
          "description": "Policy for Architecture Decision Record enforcement"
        },
        "testing": {
          "type": "string",
          "enum": ["required", "recommended", "off"],
          "description": "Policy for test suite presence requirement"
        },
        "accessibility": {
          "type": "string",
          "enum": ["required", "recommended", "off"],
          "description": "Policy for accessibility compliance checks"
        }
      }
    },
    "generation": {
      "type": "object",
      "required": ["documents"],
      "additionalProperties": false,
      "properties": {
        "documents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of document templates to generate for this profile"
        }
      }
    },
    "technologyDefaults": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Default technology and framework choices (database, cache, auth, etc.)"
    }
  }
}
