# ContextOS MCP Server — Environment Variables
# Copy this file to .env and fill in your API keys.

# At least one provider key is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: Override default models (e.g., for OpenRouter use openrouter:ox-alpha or similar depending on pi-ai format)
# CONTEXTOS_DEFAULT_MODEL=claude-sonnet-4-6
